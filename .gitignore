!.env.example

# 4. Testing, Coverage & Playwright Artifacts
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 5. TypeScript Incremental Build Cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# 6. Deployment & Agent Caches
.vercel/
.agents/

# 7. Debug & Error Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. OS & System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

