# 1. Dependencies
node_modules/
/.pnp
.pnp.js

# 2. Next.js Production Build Outputs & Cache
.next/
.next-dev/
out/
build/
dist/

# 3. Environment Variables & Secret Credentials (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local
